# Copy this file to ".env" and fill in your key(s). The .env file is gitignored.
#   cp .env.example .env
# Then generate audio for any new posts with:
#   node scripts/generate-audio.mjs

# Which TTS provider to use: openai | xai
TTS_PROVIDER=openai

# --- OpenAI (TTS_PROVIDER=openai) ---
OPENAI_API_KEY=
# Optional: voice (alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer).
# Optional: TTS_MODEL=gpt-4o-mini-tts

# --- xAI / Grok (TTS_PROVIDER=xai) ---
XAI_API_KEY=
# Optional VOICE: built-in ara, eve, leo, rex, sal — or a cloned voice id.

# Optional: narration voice for the active provider (see notes above).
# VOICE=

# --- Bias explorer video narration (scripts/biases/narrate.mjs) ---
# Uses the keys above. Each language can use its own provider and voice, e.g.
# English with the same xAI voice as the posts, Greek with OpenAI:
# TTS_PROVIDER_EN=xai
# TTS_PROVIDER_EL=openai
# VOICE_EN=
# VOICE_EL=
